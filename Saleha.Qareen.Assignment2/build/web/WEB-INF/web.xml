<?xml version="1.0" encoding="UTF-8"?>
<web-app version="4.0" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    <servlet>
        <servlet-name>FrontController</servlet-name>
        <servlet-class>viewlayer.FrontController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetAllAuthorsServlet</servlet-name>
        <servlet-class>viewlayer.GetAllAuthorsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AddAuthorServlet</servlet-name>
        <servlet-class>viewlayer.AddAuthorServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UpdateAuthorServlet</servlet-name>
        <servlet-class>viewlayer.UpdateAuthorServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DeleteAuthorServlet</servlet-name>
        <servlet-class>viewlayer.DeleteAuthorServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetAuthorByIdServlet</servlet-name>
        <servlet-class>viewlayer.GetAuthorByIdServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>NotFoundServlet</servlet-name>
        <servlet-class>viewlayer.NotFoundServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FrontController</servlet-name>
        <url-pattern>/Controller</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
    <servlet-mapping>
        <servlet-name>GetAllAuthorsServlet</servlet-name>
        <url-pattern>/GetAllAuthorsServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AddAuthorServlet</servlet-name>
        <url-pattern>/AddAuthorServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UpdateAuthorServlet</servlet-name>
        <url-pattern>/UpdateAuthorServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DeleteAuthorServlet</servlet-name>
        <url-pattern>/DeleteAuthorServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetAuthorByIdServlet</servlet-name>
        <url-pattern>/GetAuthorByIdServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>NotFoundServlet</servlet-name>
        <url-pattern>/NotFoundServlet</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
